#!/usr/bin/env bash
# Puts the engine, its packages for this platform and this machine's bun into server/engine, which the app ships as its game server.
# One folder down, because electron-builder leaves out a node_modules at the top of an extraResources folder.
# The bun must be the version in ../.bun-version: mod package installs fill its cache by that version's folder names.
set -euo pipefail
cd "$(dirname "$0")"
want="$(tr -d '[:space:]' <../.bun-version)"
have="$(bun --version)"
[ "$have" = "$want" ] || { echo "stage-engine needs bun $want (from .bun-version), but bun is $have." >&2; exit 1; }
(cd .. && bun install --frozen-lockfile)
rm -rf server
mkdir -p server/engine
cp -R ../engine ../package.json server/engine/
cp -R ../node_modules server/engine/node_modules
rm -rf server/engine/node_modules/.bin server/engine/engine/launcher.test.ts server/engine/engine/agent/node_modules
# The built-in agent's runner (Mac and Linux): OMP bundled into one file beside the engine's box, plus the native addon it loads, in its baseline build.
case "$(uname -s)" in
  Linux | Darwin)
    (cd ../engine/agent && bun install --frozen-lockfile)
    bun build ../engine/agent/runner.ts --target=bun --outdir server/engine/engine/agent -e @oh-my-pi/pi-natives -e @huggingface/transformers -e fastembed -e onnxruntime-node -e puppeteer-core -e omp-legacy-pi-modules
    natives=server/engine/engine/agent/node_modules/@oh-my-pi
    platform="pi-natives-$(bun -e 'process.stdout.write(`${process.platform}-${process.arch}`)')"
    mkdir -p "$natives"
    cp -RL ../engine/agent/node_modules/@oh-my-pi/pi-natives "../engine/agent/node_modules/@oh-my-pi/$platform" "$natives/"
    rm -f "$natives/$platform"/*-modern.node
    ;;
esac
# bun on a Mac or Linux, bun.exe on Windows.
cp "$(bun -e 'process.stdout.write(process.execPath)')" server/engine/
