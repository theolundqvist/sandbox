#!/usr/bin/env bash
# Puts the engine, its packages for this platform and this machine's bun into server/engine, which the app ships as its game server.
# One folder down, because electron-builder leaves out a node_modules at the top of an extraResources folder.
# The bun must be the version in ../.bun-version: mod package installs fill its cache by that version's folder names.
set -euo pipefail
cd "$(dirname "$0")"
want="$(tr -d '[:space:]' <../.bun-version)"
have="$(bun --version)"
[ "$have" = "$want" ] || { echo "stage-engine needs bun $want (from .bun-version), but bun is $have." >&2; exit 1; }
(cd .. && bun install --frozen-lockfile)
rm -rf server
mkdir -p server/engine
cp -R ../engine ../package.json server/engine/
cp -R ../node_modules server/engine/node_modules
rm -rf server/engine/node_modules/.bin server/engine/engine/launcher.test.ts
# bun on a Mac or Linux, bun.exe on Windows.
cp "$(bun -e 'process.stdout.write(process.execPath)')" server/engine/
